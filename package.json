{
  "name": "gittree-minimal",
  "version": "0.8.0",
  "description": "A fast, visual and privacy-first Git desktop client with a SourceTree-style graph.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "prepare:assets": "node scripts/prepare-build-assets.js",
    "validate": "npm run test && npm run audit:design",
    "quality": "npm run lint && npm run test && npm run test:coverage && npm run audit:design && npm run test:contracts",
    "lint": "eslint .",
    "audit:design": "node .agents/skills/gittree-design-system/scripts/audit-design.js",
    "perf:renderer": "node scripts/renderer-perf-benchmark.js",
    "test:renderer-ui": "node scripts/renderer-ui-regression.js",
    "test": "node --test test/*.test.js",
    "test:contracts": "node --test test/release-configuration.test.js test/i18n-parity.test.js test/hardening.test.js test/html-encoder.test.js test/dialog-service.test.js test/ipc-handler-registry.test.js test/git-ipc-handlers.test.js test/hosting-ipc-handlers.test.js test/repository-ipc-handlers.test.js test/window-application-ipc-handlers.test.js test/application-runtime.test.js test/diagnostics-exporter.test.js test/settings-diagnostics.test.js test/preload-contract.test.js test/ipc-parity.test.js",
    "test:e2e": "node --test test/e2e/electron-smoke.e2e.js",
    "test:performance": "npm run perf:renderer",
    "test:coverage": "npm run test:coverage:native && npm run test:coverage:all",
    "test:coverage:native": "node --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-branches=60 --test-coverage-functions=70 --test-coverage-include=src/main/**/*.js --test-coverage-include=src/renderer/**/*.js --test-coverage-include=src/*.js test/*.test.js",
    "test:coverage:all": "c8 --all --include=src/main/**/*.js --include=src/renderer/**/*.js --include=src/*.js --reporter=text --reporter=lcov node --test test/*.test.js",
    "test:coverage:git": "node --test --experimental-test-coverage --test-coverage-include=src/main/git-service.js test/git-service-branches.test.js test/git-service-commit-actions.test.js test/git-service-commit.test.js test/git-service-conflicts.test.js test/git-service-graph.test.js test/git-service-working-tree.test.js",
    "test:coverage:hosting": "node --test --experimental-test-coverage --test-coverage-include=src/main/hosting-service.js test/hosting-service.test.js",
    "build": "npm run prepare:assets && electron-builder --dir --publish never",
    "dist": "npm run prepare:assets && electron-builder --publish never",
    "dist:win": "npm run prepare:assets && electron-builder --win --publish never",
    "dist:mac": "npm run prepare:assets && electron-builder --mac --publish never",
    "dist:linux": "npm run prepare:assets && electron-builder --linux --publish never",
    "release:check": "node scripts/check-release-version.js",
    "release:assets": "node scripts/release-assets.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lorenzogit98/gittree-minimal.git"
  },
  "homepage": "https://github.com/lorenzogit98/gittree-minimal#readme",
  "bugs": {
    "url": "https://github.com/lorenzogit98/gittree-minimal/issues"
  },
  "keywords": [
    "git",
    "desktop",
    "electron",
    "git-client",
    "source-tree",
    "developer-tools"
  ],
  "author": {
    "name": "Lorenzo",
    "email": "lorenzo.giannoccaro998@gmail.com"
  },
  "license": "ISC",
  "desktopName": "GitTree.desktop",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "adm-zip": "^0.6.0",
    "diff2html": "^3.4.56",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.6",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "c8": "^12.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "playwright": "^1.62.1",
    "semantic-release": "^24.2.3"
  }
}
